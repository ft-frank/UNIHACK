ASSEMBLYAI_API_KEY=your_assemblyai_api_key
ANTHROPIC_API_KEY=your_anthropic_api_key

# Supabase project URL, e.g. https://your-project-ref.supabase.co
SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase public anon key for browser auth and JWT verification
SUPABASE_ANON_KEY=your_supabase_anon_key

# Supabase service role key for backend database writes
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Comma-separated emails that should bootstrap with administrator access
ADMIN_EMAILS=admin@echolearn.com

# Comma-separated frontend origins allowed to call the backend
CORS_ORIGINS=http://localhost:5173

# Frontend build/runtime settings
VITE_API_URL=http://localhost:8000
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
VITE_AUTH_REDIRECT_URL=http://localhost:5173
