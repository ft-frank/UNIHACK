ASSEMBLYAI_API_KEY=your_assemblyai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Supabase project URL
SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase public anon key
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Supabase service role key (backend only)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Frontend (Vite) — same values as above, required for Docker builds
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here
# VITE_API_URL=http://localhost:8000  # only needed if backend is not on the same host
# VITE_AUTH_REDIRECT_URL=http://localhost:80  # optional email redirect
